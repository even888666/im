<?xml version="1.0" encoding="utf-8"?>
<!-- 聊天页的语音消息（开发计划 5.5）：气泡（声波 + 时长，宽度随时长变化）+ 未听红点。本人发出的由代码改为从右到左排列 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:visibility="gone"
    tools:visibility="visible">

    <!-- 宽度由代码按时长设置（VoiceRules.bubbleWidth），背景由代码按收发设置 -->
    <LinearLayout
        android:id="@+id/bubble"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bubble_in"
        android:contentDescription="@string/chat_voice"
        android:gravity="center_vertical"
        android:minHeight="40dp"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageView
            android:id="@+id/wave"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_voice_wave_3" />

        <TextView
            android:id="@+id/duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            tools:text="5″" />
    </LinearLayout>

    <!-- 未听红点（对方发来的语音） -->
    <View
        android:id="@+id/unplayed"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_unread_dot"
        android:contentDescription="@string/chat_voice_unplayed"
        android:visibility="gone"
        tools:visibility="visible" />
</LinearLayout>
