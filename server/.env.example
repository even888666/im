# 部署配置。up.sh 首次运行时复制为 .env 并自动生成随机密码；.env 不提交到仓库。
# 部署到公司服务器时，修改 .env 中的域名、环境等配置后再运行 up.sh（见 README.md）。

# 运行环境：dev（开发，创建测试账号、写入本机 hosts）或 prod（生产）
IM_ENV=dev

# XMPP 域名（客户端访问的域名，必须在服务器证书的 SAN 中）
IM_DOMAIN=im.example.com

# 服务器证书额外的 SAN，逗号分隔，例如 DNS:im.corp.local,IP:10.1.2.3
EXTRA_SANS=

# 客户端端口（5222 XMPP、7443 HTTPS：文件上传 / WebSocket）绑定的地址
BIND_ADDRESS=0.0.0.0
# 管理后台端口（9091 HTTPS）绑定的地址；生产环境不要对外开放，默认只绑定本机
ADMIN_BIND_ADDRESS=127.0.0.1

# Openfire 容器的文件句柄上限：1 万人同时在线需要 65536 以上；不能超过宿主机的 ulimit -Hn，
# 留空时 up.sh 取 min(65536, 宿主机上限)（云开发环境的上限只有 20000）
OPENFIRE_NOFILE=

# ---------- coturn（音视频通话 STUN / TURN，功能清单 §13） ----------
# 客户端访问 TURN 的地址，默认 turn.{IM_DOMAIN}，需能被手机和 PC 解析
TURN_HOST=
TURN_PORT=3478
# 中继端口范围（UDP），防火墙需开放；生产环境按"同时通话路数 × 2"预留
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200
# 服务器在 NAT 后面时填写对外 IP（专网内一般不需要）
TURN_EXTERNAL_IP=

# 以下密码留空时由 up.sh 自动生成随机值
POSTGRES_PASSWORD=
OPENFIRE_ADMIN_PASSWORD=
# coturn 与 Openfire（External Service Discovery 插件）共享的密钥，用于生成 TURN 临时凭证
TURN_SECRET=

# 开发环境测试账号（10001 ~ 10010）的密码，仅 IM_ENV=dev 时使用
TEST_USER_PASSWORD=Test1234

# 导入的新账号首次登录是否强制修改初始密码（true / false）；留空时开发环境为 false、生产环境为 true
ORG_IMPORT_MUST_CHANGE_PASSWORD=
