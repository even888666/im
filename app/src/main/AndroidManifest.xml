<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 连接 XMPP 服务器、文件上传下载、官网版本 API -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 监听网络变化，断网 / 恢复 / 切换网络时及时重连（core.network.AndroidNetworkMonitor） -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        关闭备份（allowBackup=false，Android 12+ 另见 data_extraction_rules.xml）：
        企业 IM 的聊天记录、加密凭证不能通过 adb backup、云备份或设备迁移导出（功能清单 §14）；
        凭证用 Android Keystore 中的密钥加密，密钥本身也无法迁移，恢复出来也无法解密。
    -->
    <application
        android:name=".App"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Im">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 日志库初始化：用本项目的 LogInitializer 替代库自带的 LogbackInitializer（见 日志库/日志库说明.md） -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.startup"
            android:exported="false"
            tools:node="merge"
            tools:replace="android:authorities">
            <meta-data
                android:name="cn.android666.im.core.log.LogInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="cn.android666.logback.android.LogbackInitializer"
                tools:node="remove" />
        </provider>
    </application>

</manifest>