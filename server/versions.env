# 服务端组件版本（提交到仓库）。升级时修改此处，再运行 up.sh。
# 规则同 App：使用最新正式版，不用预发布版本（CLAUDE.md §4）。

# Openfire：https://github.com/igniterealtime/Openfire/releases
OPENFIRE_VERSION=5.1.2

# 官方插件（GitHub Releases），需兼容上面的 Openfire 版本（见各插件 plugin.xml 的 minServerVersion）
PLUGIN_MONITORING_VERSION=2.8.0
PLUGIN_HTTPFILEUPLOAD_VERSION=1.5.0
PLUGIN_EXTERNALSERVICEDISCOVERY_VERSION=1.0.4

# 基础镜像
OPENFIRE_BASE_IMAGE=eclipse-temurin:21-jre
POSTGRES_IMAGE=postgres:18-alpine
# coturn：https://hub.docker.com/r/coturn/coturn/tags
COTURN_IMAGE=coturn/coturn:4.18.0-alpine
