<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 连接 XMPP 服务器、文件上传下载、官网版本 API -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 监听网络变化，断网 / 恢复 / 切换网络时及时重连（core.network.AndroidNetworkMonitor） -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 前台服务承载长连接（功能清单 §3）；Android 14+ 需声明具体类型的权限 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Android 13+ 显示通知需要运行时权限，由保活设置向导申请（功能清单 §3） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 开机自启（功能清单 §3） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 保存图片到相册（开发计划 5.4）：Android 10 起通过 MediaStore 写入，不需要此权限 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!--
        关闭备份（allowBackup=false，Android 12+ 另见 data_extraction_rules.xml）：
        企业 IM 的聊天记录、加密凭证不能通过 adb backup、云备份或设备迁移导出（功能清单 §14）；
        凭证用 Android Keystore 中的密钥加密，密钥本身也无法迁移，恢复出来也无法解密。
    -->
    <application
        android:name=".App"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Im">
        <!-- 启动页：隐私政策弹窗，判断进入登录页 / 主界面 / 改密页（开发计划 2.17、2.18） -->
        <activity
            android:name=".ui.splash.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 登录页 -->
        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 强制修改初始密码 -->
        <activity
            android:name=".ui.password.ChangePasswordActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 主界面（底部 Tab）；singleTask：从通知等处进入时复用已有的主界面 -->
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize" />

        <!-- 组织架构浏览、同事资料卡（开发计划 3.17、3.18） -->
        <activity
            android:name=".ui.contacts.OrgBrowseActivity"
            android:exported="false" />
        <activity
            android:name=".ui.profile.EmployeeProfileActivity"
            android:exported="false" />

        <!-- 选择转发对象、合并转发的聊天记录（开发计划 4.16） -->
        <activity
            android:name=".ui.forward.ForwardTargetActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.forward.MergedMessageActivity"
            android:exported="false" />

        <!-- 大图预览（开发计划 5.4） -->
        <activity
            android:name=".ui.media.ImagePreviewActivity"
            android:exported="false"
            android:theme="@style/Theme.Im.Preview" />

        <!-- 聊天页（开发计划 4.8） -->
        <activity
            android:name=".ui.chat.ChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!--
            承载 XMPP 长连接的前台服务。类型 specialUse：企业 IM 没有厂商推送，必须保持长连接才能收到消息；
            Android 15 的开机广播不能启动 dataSync 等类型，且 dataSync 有 6 小时时长限制（功能清单 §18.1）。
        -->
        <service
            android:name=".service.ImService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="企业即时通讯：终端没有厂商推送通道，需保持与企业服务器的长连接以实时接收消息和来电" />
        </service>

        <!-- 开机自启、应用升级后恢复前台服务 -->
        <receiver
            android:name=".service.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 拍照时把照片写入应用缓存目录（开发计划 5.4），见 res/xml/file_paths.xml -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 日志库初始化：用本项目的 LogInitializer 替代库自带的 LogbackInitializer（见 日志库/日志库说明.md） -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.startup"
            android:exported="false"
            tools:node="merge"
            tools:replace="android:authorities">
            <meta-data
                android:name="cn.android666.im.core.log.LogInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="cn.android666.logback.android.LogbackInitializer"
                tools:node="remove" />
            <!-- WorkManager 改为按需初始化（App 实现 Configuration.Provider），移除默认初始化器 -->
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                tools:node="remove" />
        </provider>
    </application>

</manifest>